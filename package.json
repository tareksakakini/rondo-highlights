{
  "name": "rondo-highlights",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rondo Highlights: European football highlights, back to back.",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "vite",
    "dev:live": "VITE_DATA_BASE='https://raw.githubusercontent.com/tareksakakini/rondo-highlights/{ref}' vite",
    "build": "node scripts/gen-geo.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "ingest": "node scripts/ingest.mjs",
    "crests": "node scripts/crests.mjs",
    "condense": "node scripts/condense.mjs",
    "sample": "node scripts/build-sample.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.0",
    "vite": "^6.3.0"
  },
  "dependencies": {
    "preact": "^10.29.8"
  }
}
